{
  "compilerOptions": {
    "target": "ES2017",
    "module": "none",
    "lib": ["ES2017", "DOM"],
    "strict": true,
    "outDir": "src/static",
    "rootDir": "src/static",
    "removeComments": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/static/**/*.ts"],
  "exclude": ["node_modules"]
}
